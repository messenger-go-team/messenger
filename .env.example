# Только локальная разработка. Скопируйте файл в .env в корне репозитория.
# Значения ниже - примеры; задайте собственные локальные пароли.
POSTGRES_DB=messenger
POSTGRES_USER=messenger
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_PORT=15432

# Общий HS256-секрет auth/chat/history, минимум 32 байта.
# Сгенерируйте один ключ для всех сервисов: openssl rand -hex 32
JWT_SECRET=

REDIS_PASSWORD=change-me-local-redis
REDIS_PORT=16379
