# Site template for the existing VPS edge Nginx. Replace the hostname, certificate
# paths and loopback port with the values configured for the separate QA project.
map $http_upgrade $messenger_qa_connection {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name qa-messenger.example.org;
    ssl_certificate /etc/letsencrypt/live/qa-messenger.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qa-messenger.example.org/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:19080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Origin $http_origin;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $messenger_qa_connection;
        proxy_read_timeout 90s;
    }
}
