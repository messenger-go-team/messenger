{
  "name": "tool-trials",
  "version": "1.0.0",
  "description": "T24 local fixture trials for Bruno, Playwright and k6",
  "scripts": {
    "test": "node run-trials.cjs",
    "trial:server": "node server.cjs",
    "trial:bruno": "cd bruno && bru run --env local --reporter-json ../reports/bruno-pass.json --reporter-junit ../reports/bruno-pass.xml",
    "trial:bruno:negative": "cd bruno && bru run --env negative --reporter-json ../reports/bruno-negative.json --reporter-junit ../reports/bruno-negative.xml",
    "trial:all": "node run-trials.cjs",
    "trial:playwright": "playwright test",
    "trial:k6": "node run-k6.cjs",
    "trial:k6:negative": "node run-k6.cjs --negative"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@usebruno/cli": "4.3.0"
  },
  "private": true
}
