meta {
  name: Health check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

tests {
  test("HTTP status matches environment", function () {
    expect(res.status).to.equal(Number(bru.getEnvVar("expectedStatus")));
  });

  test("Response status is ok", function () {
    expect(res.body.status).to.equal("ok");
  });
}
