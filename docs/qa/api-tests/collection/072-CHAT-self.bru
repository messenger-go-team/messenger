}

body:json {
  {"user_id":"{{aID}}"}
}

script:pre-request {
  const { prepare } = require("./support.cjs");
  await prepare("CHAT-self", bru, req);
}

tests {
  const { verify } = require("./support.cjs");
  verify("CHAT-self", bru, req, res, test, expect);
}
