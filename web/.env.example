# Локальная разработка веб-клиента.
# Скопируйте в .env.local и при необходимости измените значения:
#   cp .env.example .env.local
#
# Файлы .env.local не коммитятся. Не кладите сюда секреты:
# все VITE_* попадают в клиентскую сборку.

# MSW-моки вместо реального backend. Включается только при точном значении true.
# При true Vite base = / (иначе service worker не перехватит /auth|/chats|/later).
VITE_API_MOCK=true

# Базовый URL API. Для моков и same-origin staging оставьте пустым.
# Для отдельного backend, например: http://localhost:8080
VITE_API_BASE_URL=

# Префикс SPA (Vite base + React Router basename). Staging: /app/
# Для локального MSW оставьте пустым или / — иначе worker под /app/ не видит API на корне.
# Production-сборка берёт /app/ из .env.production.
VITE_APP_BASE=

# Origin WebSocket без завершающего /. Пусто = текущий host (wss на staging).
# VITE_WS_ORIGIN=
