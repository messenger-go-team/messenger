# Локальная разработка веб-клиента.
# Скопируйте в .env.local и при необходимости измените значения:
#   cp .env.example .env.local
#
# Файлы .env.local не коммитятся. Не кладите сюда секреты:
# все VITE_* попадают в клиентскую сборку.

# MSW-моки вместо реального backend. Включается только при точном значении true.
VITE_API_MOCK=true

# Базовый URL API. Для моков оставьте пустым (используется origin страницы).
# Для реального backend, например: http://localhost:8080
# На staging (same-origin SPA) оставьте пустым — см. .env.production / .env.staging.example (#46).
VITE_API_BASE_URL=

# Origin WebSocket без завершающего `/` (например wss://staging.tidingm.ru).
# Пусто = схема и host текущей страницы.
VITE_WS_ORIGIN=
