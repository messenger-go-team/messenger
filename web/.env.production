# Staging/production SPA под /app/. Моки выключены.
# REST и WSS — тот же origin (пустые значения → пути /auth, /chats, /later, /ws).
# Пустой VITE_WS_ORIGIN обязателен: иначе vite build подхватит адрес из .env.local
# (например ws://localhost:18080) и встроит его в dist.
VITE_API_MOCK=false
VITE_API_BASE_URL=
VITE_WS_ORIGIN=
VITE_APP_BASE=/app/
