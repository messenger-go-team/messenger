# Пример профиля для сборки/проверки против staging (#46).
# Скопируйте при необходимости:
#   cp .env.staging.example .env.staging.local
# Сборка: npm run build -- --mode staging
# (или используйте .env.production — тот же same-origin профиль.)
#
# На стенде SPA должна отдаваться с https://staging.tidingm.ru (см. web/Dockerfile).
# Пока ingress отдаёт 404 на `/`, клиент на публичном URL не поднимется — нужен
# деплой web-образа и proxy `location /` → web (devops / #46).

VITE_API_MOCK=false
VITE_API_BASE_URL=
VITE_WS_ORIGIN=
